# Web
PORT=5000
NODE_ENV=development

# PostgreSQL production persistence. Omit for local file-backed mode.
DATABASE_URL=

# Replit OIDC production auth. Omit REPL_ID to use the local development identity.
REPL_ID=
SESSION_SECRET=
ISSUER_URL=https://replit.com/oidc

# Synthia / consciousness service
# Set START_CONSCIOUSNESS=0 when running the service separately or when the core app should run without it.
START_CONSCIOUSNESS=1
CONSCIOUSNESS_SERVER_URL=http://localhost:5001
